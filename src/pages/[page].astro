---
// Renders every long-form page from src/content/pages/ at /<filename>/.
// To add a new page, drop a .mdx file in that folder — no code changes needed.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((entry) => ({ params: { page: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, eyebrow, lede, variant, description, portrait, portraitAlt } = entry.data;
---

<Base title={title} description={description ?? lede}>
  <article class="wrap">
    <header class:list={['pagehead', { 'has-portrait': portrait }]}>
      <div class="headtext">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        {lede && <p class="lede">{lede}</p>}
      </div>
      {
        portrait && (
          <Image class="portrait" src={portrait} alt={portraitAlt ?? title} width={480} densities={[1, 2]} />
        )
      }
    </header>
    <div class:list={['prose', { 'prose-rail': variant === 'rail' }]}>
      <Content />
    </div>
  </article>
</Base>

<style>
  .pagehead {
    padding: clamp(48px, 7vw, 80px) 0 clamp(32px, 4vw, 48px);
    border-bottom: 1px solid var(--rule);
    margin-bottom: clamp(32px, 4vw, 48px);
    max-width: 46ch;
  }

  /* When a portrait is present, the header widens into a two-column layout. */
  .pagehead.has-portrait {
    max-width: none;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(24px, 4vw, 56px);
  }

  .pagehead.has-portrait .headtext {
    max-width: 46ch;
  }

  .portrait {
    width: clamp(140px, 18vw, 220px);
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 3px;
    flex: none;
  }

  @media (max-width: 640px) {
    .pagehead.has-portrait {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }

  .pagehead h1 {
    font-size: clamp(2rem, 1.5rem + 2.2vw, 3rem);
    line-height: 1.1;
    margin-top: 14px;
  }

  .lede {
    margin-top: 16px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.18rem;
    color: var(--ink-soft);
  }

  /* Give the rail number room on wide screens by nudging content right. */
  article :global(.prose-rail) {
    margin-left: 0;
  }

  @media (min-width: 1080px) {
    article :global(.prose-rail) {
      margin-left: 100px;
    }
  }
</style>
