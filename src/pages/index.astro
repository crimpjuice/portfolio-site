---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = await getCollection('projects');
const featured = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Home">
  <!-- Hero -->
  <section class="wrap hero">
    <div>
      <p class="eyebrow">Learning designer &middot; AI in learning</p>
      <h1>Everything starts from <span class="accentline">a human problem.</span></h1>
      <p class="thesis">
        I build learning that changes what people can do, then check whether it worked. I use AI
        for the fast parts and keep the judgement calls for myself. Most of what is on this site
        you can open and try.
      </p>
      <div class="ctarow">
        <a class="btn solid" href="#open">Open the work</a>
        <a class="btn" href="/projects/">All {projects.length} case studies</a>
      </div>
    </div>
    <svg class="diagram" viewBox="0 0 300 320" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <line x1="20" y1="20" x2="20" y2="290" stroke="var(--rule)" stroke-width="1"></line>
      <line x1="20" y1="290" x2="290" y2="290" stroke="var(--rule)" stroke-width="1"></line>
      <path
        class="trace-path"
        d="M20,260 C70,255 90,150 130,140 C170,130 190,60 220,45 C240,35 260,30 280,22"></path>
      <circle cx="280" cy="22" r="4" fill="var(--accent)"></circle>
      <text x="26" y="40" class="axislabel">retention</text>
      <text x="180" y="308" class="axislabel">productive struggle &rarr;</text>
    </svg>
  </section>

  <!-- Impact strip -->
  <section class="wrap section reveal">
    <div class="section-head">
      <span class="eyebrow">In numbers</span>
      <div class="hrule"></div>
    </div>
    <dl class="stats">
      <div>
        <dt>Learner attempts analysed at Ello to find where kids quit</dt>
        <dd>89,000</dd>
      </div>
      <div>
        <dt>AI-built math activities I polished that reached production or went live</dt>
        <dd>25 of 31</dd>
      </div>
      <div>
        <dt>Fewer repeat support requests after I deployed an AI physics tutor</dt>
        <dd>22%</dd>
      </div>
      <div>
        <dt>Instructors who changed their course within 10 days of my workshop</dt>
        <dd>4 of 5</dd>
      </div>
    </dl>
  </section>

  <!-- Open the work -->
  <section class="wrap section reveal" id="open">
    <div class="section-head">
      <span class="eyebrow">Open the work</span>
      <div class="hrule"></div>
      <h2>Things you can try in two minutes</h2>
    </div>
    <p class="sectionintro">
      These are the real tools and the real prompts, as my students and colleagues use them.
    </p>
    <ul class="openlist">
      <li>
        <a href="https://gemini.google.com/gem/1pdjz2IzPjLi9m7L_FzomHLR1nEPRmPEV?usp=sharing" target="_blank" rel="noopener noreferrer">Charger, a Socratic physics tutor &nearr;</a>
        <span>Give it a physics problem. It asks one question per turn and will not hand you the answer. <a href="/projects/ai-tutors/">Read its full prompt.</a></span>
      </li>
      <li>
        <a href="https://phys104review2026.netlify.app/" target="_blank" rel="noopener noreferrer">A 90-minute exam review session &nearr;</a>
        <span>Runs in the browser, tracks each student's gaps, and hands them to an AI study coach. <a href="/projects/exam-review/">How it was designed.</a></span>
      </li>
      <li>
        <a href="https://ampereslaw-intuition.netlify.app/" target="_blank" rel="noopener noreferrer">Road to Amp&egrave;re's Law, an interactive mini-lesson &nearr;</a>
        <span>Builds a feel for the idea before the mathematics arrives. <a href="/projects/mini-lessons-intuition/">Case study.</a></span>
      </li>
      <li>
        <a href="https://heat-temp-energy-misconception.netlify.app/" target="_blank" rel="noopener noreferrer">Heat, Temperature &amp; Internal Energy &nearr;</a>
        <span>A lesson that triggers the common wrong idea first, then makes it fail. <a href="/projects/mini-lessons-misconceptions/">Case study.</a></span>
      </li>
      <li>
        <a href="/projects/lab-report-feedback/">The lab-report feedback prompt</a>
        <span>The working prompt, published in full, and how I check every draft it writes.</span>
      </li>
      <li>
        <a href="/projects/ello-polish-playbook/">The Polish Playbook</a>
        <span>The two-hour workflow and five-part scorecard I built for a team revising AI-generated activities.</span>
      </li>
    </ul>
  </section>

  <!-- Featured projects -->
  <section class="wrap section reveal">
    <div class="section-head">
      <span class="eyebrow">Selected work</span>
      <div class="hrule"></div>
      <h2>Start with these four</h2>
    </div>
    <p class="sectionintro">
      How I work with AI and where my judgement mattered, what 89,000 learner attempts said about
      why kids quit, the system I built from that, and two workshops that changed how instructors
      teach.
    </p>
    <div class="cardgrid">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
    <p class="allline">
      <a href="/projects/">See all {projects.length} case studies &rarr;</a>
    </p>
  </section>

  <!-- More -->
  <section class="wrap section reveal">
    <div class="paths">
      <div class="path">
        <p class="pathlabel">Background</p>
        <p>
          <a href="/about/">About</a> has my history in one page. <a href="/teaching-philosophy/">Teaching Philosophy</a> and
          <a href="/human-classroom/">The Human Classroom</a> explain the thinking underneath the work.
        </p>
      </div>
      <div class="path">
        <p class="pathlabel">For colleagues at Camosun</p>
        <p>
          Practical tools, guides, and workshop materials for bringing AI into your teaching,
          built by a faculty member for faculty. Head to
          <a href="/for-colleagues/">Resources for Colleagues</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 320px);
    gap: 40px;
    align-items: center;
    padding-top: clamp(48px, 7vw, 88px);
    padding-bottom: clamp(48px, 7vw, 88px);
  }

  .hero h1 {
    font-size: clamp(2.3rem, 1.6rem + 3.2vw, 3.7rem);
    line-height: 1.06;
    margin-top: 18px;
  }

  .accentline {
    color: var(--accent);
  }

  .thesis {
    margin-top: 22px;
    font-size: 1.1rem;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .ctarow {
    margin-top: 30px;
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .diagram {
    aspect-ratio: 1 / 1.05;
  }

  .axislabel {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--ink-faint);
  }

  .trace-path {
    stroke: var(--accent);
    stroke-width: 2.5;
    fill: none;
    stroke-linecap: round;
  }

  @media (prefers-reduced-motion: no-preference) {
    .trace-path {
      stroke-dasharray: 520;
      stroke-dashoffset: 520;
      animation: draw 2.2s 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .diagram {
      max-width: 200px;
    }
  }

  .paths {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
  }

  .pathlabel {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .path p:not(.pathlabel) {
    color: var(--ink-soft);
  }

  .sectionintro {
    color: var(--ink-soft);
    max-width: 66ch;
    margin-bottom: 32px;
  }

  .cardgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .allline {
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 32px;
    margin: 0;
  }

  .stats dd {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 2.3rem;
    margin: 0;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .stats dt {
    font-size: 0.85rem;
    color: var(--ink-faint);
    order: 1;
    max-width: 24ch;
  }

  .stats > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 2px solid var(--accent);
    padding-top: 14px;
  }

  .openlist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .openlist li {
    background: var(--paper);
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .openlist li > a {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
    text-decoration: none;
  }

  .openlist li > a:hover {
    color: var(--accent);
  }

  .openlist span {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .stats dd {
    white-space: nowrap;
  }
</style>
