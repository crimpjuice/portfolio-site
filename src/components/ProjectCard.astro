---
// One card in the projects gallery / featured grid.
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, category, summary, tools } = project.data;
---

<article class="card" data-category={category}>
  <p class="cat">{category}</p>
  <h3><a href={`/projects/${project.id}/`}>{title}</a></h3>
  <p class="summary">{summary}</p>
  <div class="chiprow">
    {tools.map((tool) => <span class="chip">{tool}</span>)}
  </div>
  <span class="go" aria-hidden="true">Read case study &rarr;</span>
</article>

<style>
  .card {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 16px;
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    position: relative;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--rule));
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .cat {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  h3 {
    font-size: 1.25rem;
    line-height: 1.25;
  }

  /* The whole card is clickable via a stretched link. */
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .summary {
    color: var(--ink-soft);
    font-size: 0.92rem;
    flex: 1;
  }

  .go {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }
</style>
